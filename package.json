{
  "name": "seetheforest-obsidian-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "lint:source": "eslint --config eslint.source.config.mjs src",
    "ci:source": "node scripts/ci.mjs source",
    "ci:full": "node scripts/ci.mjs full",
    "test:ci": "node --test tests/ci/*.test.mjs",
    "fetch:atlas": "node scripts/fetch-atlas.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "prepare:atlas": "node scripts/prepare-atlas.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:installed-runtime": "node scripts/verify-installed-runtime.mjs",
    "package": "npm run build && npm run verify:package && node scripts/package.mjs"
  },
  "dependencies": {
    "@seetheforest/atlas": "file:vendor/atlas.tgz",
    "pixi.js": "8.19.0",
    "solid-js": "1.9.14"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.25.12",
    "eslint": "10.12.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "fflate": "0.8.2",
    "obsidian": "1.12.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
